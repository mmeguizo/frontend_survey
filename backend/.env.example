DATABASE_URL="mysql://root:root@localhost:3306/ictsupport"
# Google OAuth credentials
OAUTH_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
OAUTH_CLIENT_SECRET="your-google-client-secret"
OAUTH_REDIRECT_URI="http://localhost:4200/auth/callback"

# Public base URL used to build absolute URLs for uploaded files
PUBLIC_BASE_URL="http://localhost:4000"

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN="http://localhost:4200"

# AI providers (at least one is required for AI features)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
PERPLEXITY_API_KEY=""
HF_TOKEN="your-huggingface-token"
HF_MODEL="Qwen/Qwen2.5-72B-Instruct"

# AI resilience tuning
# How long to wait for one provider before trying the next (ms)
AI_REQUEST_TIMEOUT_MS=45000
